# =============================================================================
# Hunarmand frontend (Next.js, Vercel)
# =============================================================================
# Copy to .env.local for local development.
# In Vercel set this same env var in Project Settings → Environment Variables.
# =============================================================================

# The deployed backend on Render. The frontend talks ONLY to this URL;
# the backend then proxies to the AI core. Single CORS surface, single
# auth model.
NEXT_PUBLIC_HUNARMAND_API=https://hunarmand-backend.onrender.com
