# =============================================================================
# Hunarmand AI Core — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values for the providers you want
# to enable. Anything left blank just disables that provider — the system
# degrades gracefully through its fallback ladder.
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
HUNARMAND_ENV=development
HUNARMAND_LOG_LEVEL=INFO
HUNARMAND_HOST=0.0.0.0
HUNARMAND_PORT=8000
HUNARMAND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (Postgres + pgvector) ──────────────────────────────────────────
# `docker compose up -d` brings this up locally on the URL below.
HUNARMAND_DATABASE_URL=postgresql+asyncpg://hunarmand:hunarmand@localhost:5432/hunarmand

# ── Object storage (S3-compatible; only needed for production media) ────────
HUNARMAND_S3_ENDPOINT=
HUNARMAND_S3_REGION=ap-south-1
HUNARMAND_S3_BUCKET=hunarmand-vault
HUNARMAND_S3_ACCESS_KEY=
HUNARMAND_S3_SECRET_KEY=

# ── Sanad cryptographic root key ────────────────────────────────────────────
# Used to encrypt artisan private keys at rest (NaCl SecretBox).
# Generate locally: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# DO NOT commit a real value to source control.
HUNARMAND_KEK_SECRET=change-me-to-a-real-32-byte-urlsafe-secret

# ── LLM provider ────────────────────────────────────────────────────────────
# Provider for interview engine, Craft DNA extractor, and "Ask the Hunarmand".
# Options: openai | anthropic
HUNARMAND_LLM_PROVIDER=openai
HUNARMAND_LLM_MODEL=gpt-4o-2024-11-20
HUNARMAND_LLM_TEMPERATURE=0.2

# OpenAI (used for LLM, embeddings, and Whisper ASR)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (alternative LLM provider)
ANTHROPIC_API_KEY=

# Embeddings — used by RAG retrieval
HUNARMAND_EMBEDDING_PROVIDER=openai
HUNARMAND_EMBEDDING_MODEL=text-embedding-3-small
HUNARMAND_EMBEDDING_DIMENSIONS=1536

# ── ASR fallback ladder ─────────────────────────────────────────────────────
# Comma-separated list, tried in order. Allowed: bhashini, ai4bharat, whisper, manual
HUNARMAND_ASR_LADDER=bhashini,ai4bharat,whisper,manual
HUNARMAND_ASR_DEFAULT_LANGUAGE=ks

# Bhashini ULCA (Government of India) — first-class Kashmiri (`ks`) support.
# https://bhashini.gov.in/ulca
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# AI4Bharat IndicWhisper / IndicConformer — open-source 36 Indic languages incl. ks.
# Run a local or remote inference endpoint that matches the OpenAI Audio API shape.
# Example: a vLLM or HF text-generation-inference endpoint, or your own FastAPI shim.
AI4BHARAT_INFERENCE_URL=
AI4BHARAT_API_KEY=
AI4BHARAT_MODEL=ai4bharat/indicwhisper

# Whisper (OpenAI Audio API) — uses OPENAI_API_KEY above.
HUNARMAND_WHISPER_MODEL=whisper-1

# ── Translation ─────────────────────────────────────────────────────────────
# Translates Vault transcripts from Koshur/Urdu/Hindi → English (and others on demand).
# Options: openai | bhashini | none
HUNARMAND_TRANSLATION_PROVIDER=openai
HUNARMAND_TRANSLATION_MODEL=gpt-4o-mini

# ── RAG ─────────────────────────────────────────────────────────────────────
HUNARMAND_RAG_CHUNK_TOKENS=320
HUNARMAND_RAG_CHUNK_OVERLAP=50
HUNARMAND_RAG_TOP_K=6
HUNARMAND_RAG_SCORE_THRESHOLD=0.32
HUNARMAND_RAG_REFUSE_BELOW=0.28

# ── Sanad ───────────────────────────────────────────────────────────────────
HUNARMAND_SANAD_BASE_URL=https://hunarmand.app/s
HUNARMAND_SANAD_VERIFIER_KEY_VERSION=v1
