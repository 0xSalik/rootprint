# =============================================================================
# Hunarmand AI Core — Environment Configuration
# =============================================================================
# Copy this file to `.env` and set the values for the providers you want to
# enable. Anything you leave blank just disables that provider — the system
# degrades through its fallback ladders.
#
# THREE preset paths:
#
#   1. FULLY FREE (default) — OpenRouter free LLM + Groq Whisper + local
#      sentence-transformers. Only requires OPENROUTER_API_KEY and
#      (optionally) GROQ_API_KEY. Both are free; sign up at:
#          https://openrouter.ai/keys
#          https://console.groq.com/keys
#
#   2. JINA EMBEDDINGS — same as #1 but swap the embedder to Jina (free
#      tier with API key, no PyTorch download).
#
#   3. PAID OPENAI — set OPENAI_API_KEY and switch HUNARMAND_LLM_PROVIDER
#      to ``openai`` and HUNARMAND_EMBEDDING_PROVIDER to ``openai``.
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
HUNARMAND_ENV=development
HUNARMAND_LOG_LEVEL=INFO
HUNARMAND_HOST=0.0.0.0
HUNARMAND_PORT=8000
HUNARMAND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (Postgres + pgvector) ──────────────────────────────────────────
HUNARMAND_DATABASE_URL=postgresql+asyncpg://hunarmand:hunarmand@localhost:5432/hunarmand

# ── Sanad cryptographic root key ────────────────────────────────────────────
# Encrypts artisan private keys at rest (NaCl SecretBox). Generate locally:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HUNARMAND_KEK_SECRET=change-me-to-a-real-32-byte-urlsafe-secret

# =============================================================================
# LLM provider — interview engine, Craft DNA extractor, "Ask the Hunarmand"
# =============================================================================
# Allowed: openrouter | openai | anthropic
HUNARMAND_LLM_PROVIDER=openrouter

# A genuinely free, capable default. Recommended free-tier models on
# OpenRouter (rotate as availability changes):
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
#   deepseek/deepseek-chat:free
#   qwen/qwen-2.5-72b-instruct:free
#   nousresearch/hermes-3-llama-3.1-405b:free
HUNARMAND_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
HUNARMAND_LLM_TEMPERATURE=0.2

# Structured-output strategy. Most free OpenRouter models do not support
# `json_schema` mode but DO support `json_object`. Defaults are sensible
# per provider; only set this if you need to override.
#   auto    — pick per provider (default)
#   schema  — strict JSON-schema mode (needs a schema-capable model)
#   json    — JSON-mode (most free models support this)
#   prompt  — prompt-only; works with any model
HUNARMAND_LLM_STRUCTURED_MODE=auto

# OpenRouter — free + paid; OpenAI-compatible API.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://hunarmand.app
OPENROUTER_APP_NAME=Hunarmand AI

# OpenAI — direct (paid). Used when HUNARMAND_LLM_PROVIDER=openai or for
# OpenAI Whisper or OpenAI embeddings.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (paid alternative).
ANTHROPIC_API_KEY=

# =============================================================================
# Embeddings — used by RAG / "Ask the Hunarmand"
# =============================================================================
# Allowed: local | jina | openai
#
# Defaults to ``local`` (sentence-transformers, truly free, no API). To
# enable, install the optional extra: ``pip install '.[local-embeddings]'``
# Jina is the lightest free remote alternative; OpenAI is paid.
HUNARMAND_EMBEDDING_PROVIDER=local

# Default model + dim per provider:
#   local  -> intfloat/multilingual-e5-small (384d)  [multilingual incl. Hindi/Urdu]
#   local  -> BAAI/bge-m3 (1024d)                    [stronger multilingual, larger]
#   jina   -> jina-embeddings-v3 (configurable 1..1024d, default 1024d)
#   openai -> text-embedding-3-small (1536d) or 3-large (3072d)
HUNARMAND_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HUNARMAND_EMBEDDING_DIMENSIONS=384

# Jina API (free tier).  https://jina.ai/embeddings/
JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1

# =============================================================================
# ASR fallback ladder
# =============================================================================
# Comma-separated, tried in order.
# Allowed: bhashini, ai4bharat, groq, hf_inference, whisper, manual
#   - groq: Whisper-large-v3-turbo on Groq's free tier (very fast).
#   - hf_inference: HF Inference API Whisper (free; same HF account as your Space).
#   - whisper: OpenAI Audio API (paid).
HUNARMAND_ASR_LADDER=bhashini,ai4bharat,groq,hf_inference,whisper,manual
HUNARMAND_ASR_DEFAULT_LANGUAGE=ks

# Groq — free Whisper API, very fast inference. Sign up at:
#   https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
HUNARMAND_GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# OpenAI Whisper (paid; uses OPENAI_API_KEY above).
HUNARMAND_WHISPER_MODEL=whisper-1

# Bhashini ULCA — Government of India, first-class Kashmiri (`ks`) ASR.
#   https://bhashini.gov.in/ulca
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_INFERENCE_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# AI4Bharat IndicWhisper / IndicConformer — open-source, 36 Indic langs incl. ks.
# Point at a HuggingFace Inference Endpoint or a self-hosted shim that
# accepts multipart audio uploads.
AI4BHARAT_INFERENCE_URL=
AI4BHARAT_API_KEY=
AI4BHARAT_MODEL=ai4bharat/indicwhisper

# Hugging Face Inference API — free Whisper, uses the same HF account
# as your Space deployment. Generate a read token at:
#   https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_INFERENCE_BASE_URL=https://api-inference.huggingface.co/models
HUNARMAND_HF_WHISPER_MODEL=openai/whisper-large-v3

# =============================================================================
# Translation
# =============================================================================
# Allowed: llm | bhashini | none
# `llm` translates via the configured HUNARMAND_LLM_PROVIDER (default).
HUNARMAND_TRANSLATION_PROVIDER=llm
# Defaults to HUNARMAND_LLM_MODEL when blank — keeps the free path free.
HUNARMAND_TRANSLATION_MODEL=

# =============================================================================
# RAG
# =============================================================================
HUNARMAND_RAG_CHUNK_TOKENS=320
HUNARMAND_RAG_CHUNK_OVERLAP=50
HUNARMAND_RAG_TOP_K=6
HUNARMAND_RAG_SCORE_THRESHOLD=0.32
HUNARMAND_RAG_REFUSE_BELOW=0.28

# =============================================================================
# Sanad
# =============================================================================
HUNARMAND_SANAD_BASE_URL=https://hunarmand.app/s
HUNARMAND_SANAD_VERIFIER_KEY_VERSION=v1

# =============================================================================
# Graceful-degradation fallbacks
# =============================================================================
# Slow / flaky free-tier inference can leave the UI hanging. Each
# slow endpoint is wrapped with a per-endpoint timeout and falls back
# to a curated payload (see hunarmand_ai/fallbacks/) so the frontend
# always has something to render. Set to 0 to disable globally — useful
# in CI to surface real failures.
HUNARMAND_FALLBACK_ENABLED=1
HUNARMAND_FALLBACK_TIMEOUT_DEFAULT=8
HUNARMAND_FALLBACK_TIMEOUT_ASK=10
HUNARMAND_FALLBACK_TIMEOUT_EXTRACT=20
HUNARMAND_FALLBACK_TIMEOUT_ASR=15
