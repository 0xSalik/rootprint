# =============================================================================
# Hunarmand Backend — environment configuration
# =============================================================================
# Copy to .env and fill in. The shipped defaults are tuned for a local
# laptop demo with the AI core deployed on Hugging Face Spaces and
# Postgres on Neon (no Redis required — see RUN_INLINE_TASKS).
# =============================================================================

# ── Project ──────────────────────────────────────────────────────────────────
PROJECT_NAME=Hunarmand API
API_V1_STR=/api/v1

# Origins allowed to call the API (comma-separated).
# Add http://localhost:3000 for local Next.js dev and your Vercel URL.
BACKEND_CORS_ORIGINS=http://localhost:3000,https://hunarmand.vercel.app

# ── Postgres / Neon ──────────────────────────────────────────────────────────
# Either set the discrete fields below OR set HUNARMAND_DATABASE_URL directly
# (the latter wins). The DATABASE_URL form is what we use against Neon.
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hunarmand_db
POSTGRES_PORT=5432

# Neon: paste the *pooled* connection string and rewrite postgresql:// to
# postgresql+asyncpg:// and drop the ?sslmode=require suffix (asyncpg
# uses ssl, not sslmode).
HUNARMAND_DATABASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── S3 / Cloudflare R2 ───────────────────────────────────────────────────────
# Cloudflare R2 example values; leave blank for local-only demos that don't
# need uploads.
S3_BUCKET=hunarmand-vault
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── AI Core ──────────────────────────────────────────────────────────────────
# The deployed Hugging Face Space URL — e.g.
#   https://slimshadylol-hunarmand-ai.hf.space
AI_CORE_URL=https://slimshadylol-hunarmand-ai.hf.space

# Optional: shared secret to authenticate backend->AI core calls. Leave
# blank for the public hackathon Space. If the AI core ever moves
# behind auth, populate this and forward as a Bearer token.
AI_CORE_TOKEN=

# Embedding dimension MUST match what the AI core's embedder produces.
# Default 384 corresponds to intfloat/multilingual-e5-small.
HUNARMAND_EMBEDDING_DIMENSIONS=384

# ── Background tasks ─────────────────────────────────────────────────────────
# Celery is the production path. For a laptop demo (no Redis) set
# RUN_INLINE_TASKS=1 and the backend runs the same pipeline through
# FastAPI BackgroundTasks instead — the frontend contract is identical.
RUN_INLINE_TASKS=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Logging ──────────────────────────────────────────────────────────────────
HUNARMAND_LOG_LEVEL=INFO

# ── Graceful-degradation fallbacks ───────────────────────────────────────────
# The slow paths (`/api/v1/search/techniques` and `/api/v1/ask`) wrap the
# upstream call with a per-endpoint timeout. On timeout or error we
# return a curated payload so the frontend never has to render an empty
# state. Set to 0 in CI / local dev to surface real failures.
HUNARMAND_FALLBACK_ENABLED=1
HUNARMAND_FALLBACK_TIMEOUT_DEFAULT=8
HUNARMAND_FALLBACK_TIMEOUT_SEARCH=8
HUNARMAND_FALLBACK_TIMEOUT_ASK=12
